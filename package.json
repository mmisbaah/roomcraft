{
  "name": "roomcraft",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Draw your floorplan, AI fills it with furniture - 2D and 3D DIY interior design",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "node check-types-deps.mjs && tsc -p tsconfig.check.json --noEmit",
    "test:placement": "esbuild test-canplaceraw.ts --bundle --platform=node --format=cjs --outfile=test-canplacerow.cjs --log-level=error && node test-canplacerow.cjs",
    "test:walls": "esbuild test-wallsnap.ts --bundle --platform=node --format=cjs --outfile=test-wallsnap.cjs --log-level=error && node test-wallsnap.cjs",
    "test:rooms": "esbuild test-roomnote.ts --bundle --platform=node --format=cjs --outfile=test-roomnote.cjs --log-level=error && node test-roomnote.cjs",
    "test:presets": "esbuild test-presets.ts --bundle --platform=node --format=cjs --outfile=test-presets.cjs --log-level=error && node test-presets.cjs",
    "test:rules": "esbuild test-rules.ts --bundle --platform=node --format=cjs --outfile=test-rules.cjs --log-level=error && node test-rules.cjs",
    "test:coverage": "esbuild test-coverage.ts --bundle --platform=node --format=cjs --outfile=test-coverage.cjs --log-level=error && node test-coverage.cjs",
    "test:roomrules": "esbuild test-roomrules.ts --bundle --platform=node --format=cjs --outfile=test-roomrules.cjs --log-level=error && node test-roomrules.cjs",
    "test:grab": "esbuild test-wallgrab.ts --bundle --platform=node --format=cjs --outfile=test-wallgrab.cjs --log-level=error && node test-wallgrab.cjs",
    "test:enclose": "esbuild test-enclose.ts --bundle --platform=node --format=cjs --outfile=test-enclose.cjs --log-level=error && node test-enclose.cjs",
    "test:wallroom": "esbuild test-wallroom.ts --bundle --platform=node --format=cjs --outfile=test-wallroom.cjs --log-level=error && node test-wallroom.cjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "verify:electron": "node verify-electron.cjs && node test-index-resolve.cjs",
    "icon": "node make-icon.cjs",
    "dist": "npm run electron:build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "lightningcss": "^1.33.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.1",
    "electron": "38.1.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.roomcraft.app",
    "productName": "RoomCraft",
    "copyright": "Copyright © 2026 RoomCraft",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "mmisbaah",
      "repo": "roomcraft"
    }
  }
}

