# Paddle Billing (optional for local development - without these the app runs in DEMO mode:
# clicking "Upgrade" unlocks the tier instantly without payment).
# For production (Vercel): set these in the project env vars.
#
# Client-side (Vite) — price IDs are public:
VITE_PADDLE_PRICE_PRO=
VITE_PADDLE_PRICE_MAX=
#
# Server-side (Vercel env vars, NOT prefixed with VITE_):
#   PADDLE_API_KEY         — Paddle dashboard → Developer → API access
#   PADDLE_LICENSE_SECRET  — any long random string, used to sign licenses
#   PADDLE_WEBHOOK_SECRET  — Paddle dashboard → Developer → Webhooks
#   PADDLE_SANDBOX         — "true" (default) or "false" for live mode
